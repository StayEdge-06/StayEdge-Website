# ============================================================
# StayEdge website — environment configuration
# Copy to .env.local (dev) or set in the hosting dashboard (prod).
# Everything is optional: unset values degrade gracefully.
# ============================================================

# Canonical site URL (sitemap, OG, JSON-LD). Defaults to https://www.stayedge.co.in
# MUST match the host Vercel actually serves — the apex domain 308-redirects
# to www, so this must be the www host or every canonical/sitemap/JSON-LD
# URL points at a redirecting URL (self-referential-canonical failure).
# If this var is set in the Vercel dashboard to the apex domain, update it
# there too — it overrides this file's default.
NEXT_PUBLIC_SITE_URL=https://www.stayedge.co.in

# --- StayEdge OS (n8n) — the single intelligence layer ---
# RENAMED in V2 (was N8N_ROAST_WEBHOOK_URL / N8N_ROAST_TOKEN). The AI Roast is
# gone; these names describe what the gateway actually is. Rename them in the
# Vercel dashboard too — the old names are no longer read.
# WEB-HEAD webhook (health probe for the /os dashboard).
N8N_BRAIN_WEBHOOK_URL=
# WEB-HEAD webhook (lead events → CRM + Telegram founder notify).
N8N_LEAD_WEBHOOK_URL=
# WEB-HEAD webhook (business metrics for the /os dashboard).
N8N_METRICS_WEBHOOK_URL=
# Optional bearer token all WEB-HEAD webhooks expect.
N8N_WEBHOOK_TOKEN=
# Optional HMAC-SHA256 signing secret for the lead webhook body, sent as
# X-StayEdge-Signature: sha256=<hex>. Independent of the bearer token: the token
# proves who is calling, the signature proves the body was not altered and
# cannot be replayed with different content. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_WEBHOOK_SECRET=

# --- Lead pipeline: Google Sheets CRM (server-only, never NEXT_PUBLIC_) ---
# A service account with edit access to the sheet. Unset = the Sheets write is
# skipped and the lead still reaches the other channels; nothing throws.
# GOOGLE_PRIVATE_KEY holds literal "\n" sequences, which the code unescapes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_ID=
# Only the TAB NAME is read from this ("Leads" from "Leads!A:K"). The column
# span is always A:U, derived from the canonical schema in lib/leads/schema.ts,
# so a stale range here can never truncate a lead row. Defaults to Leads.
GOOGLE_SHEETS_RANGE=

# --- Lead pipeline: Telegram founder notification (server-only) ---
# Both must be set or the notify is skipped. In development leave them unset:
# a real bot token here sends real messages to the founder from local tests.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Internal CEO dashboard (/os) ---
# The login key, typed once at /os/login and exchanged for an httpOnly session
# cookie. It is NEVER put in a URL (the Phase 1 ?key= scheme is gone: query
# strings leak into logs, Referer headers and browser history). Unset — or
# shorter than 16 characters — disables the dashboard entirely (404). Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
OS_DASHBOARD_KEY=
# Optional, recommended: the HMAC secret that signs the session cookie. Keeping
# it separate from the login key means rotating either one alone. When unset,
# OS_DASHBOARD_KEY signs the cookie — so changing the login key also, by design,
# invalidates every existing session.
OS_SESSION_SECRET=

# --- Analytics (consent-gated; nothing loads until the visitor allows) ---
# GA4 measurement id (legacy NEXT_PUBLIC_GA_ID also still read)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity project id (loads production-only via next/script)
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# --- Google Business Profile ---
# The public Maps/profile URL of the VERIFIED GBP listing. Unset = the profile
# simply does not appear in sameAs/hasMap. Never guess a value here: a wrong
# maps URL is a false identity claim and actively hurts entity resolution.
NEXT_PUBLIC_GBP_URL=

# --- Preview/testing ---
# Set to 1 to force the static AI-presence fallback (headless/low-power hosts).
# NEXT_PUBLIC_DISABLE_3D=1
